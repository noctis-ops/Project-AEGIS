# Copy names into AWS Secrets Manager or /etc/aegis/aegis.env (0600).
# Never commit real values.
AEGIS_SHADOW_EQUITY=1000
AEGIS_LIVE_EQUITY_BOOTSTRAP=100
AEGIS_JSON_LOGS=1
RUST_LOG=project_aegis=info
AEGIS_STATSD_ADDR=127.0.0.1:8125

# Required only for a live build.
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
AEGIS_LIVE_TRADING=

# Optional command-only Telegram C2.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
TELEGRAM_NOTIFICATION_CHAT_ID=
AEGIS_C2_CONFIRMATION_CODE=
