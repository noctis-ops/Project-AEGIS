#!/bin/bash
set -euo pipefail
dnf install -y docker jq awscli
systemctl enable --now docker
mkdir -p /etc/aegis
chmod 700 /etc/aegis
aws secretsmanager get-secret-value --region '${region}' --secret-id '${secrets_arn}' --query SecretString --output text \
  | jq -r 'to_entries[] | "\(.key)=\(.value)"' > /etc/aegis/aegis.env
chmod 600 /etc/aegis/aegis.env
aws ecr get-login-password --region '${region}' | docker login --username AWS --password-stdin '${account_id}.dkr.ecr.${region}.amazonaws.com'
docker pull '${account_id}.dkr.ecr.${region}.amazonaws.com/${repository}:${image_tag}'
docker tag '${account_id}.dkr.ecr.${region}.amazonaws.com/${repository}:${image_tag}' project-aegis:current
cat >/etc/systemd/system/aegis.service <<'UNIT'
[Unit]
Description=Project AEGIS
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
[Service]
Type=simple
ExecStartPre=-/usr/bin/docker rm -f aegis
ExecStart=/usr/bin/docker run --name aegis --network host --read-only --cap-drop ALL --security-opt no-new-privileges --env-file /etc/aegis/aegis.env project-aegis:current shadow BTCUSDT
ExecStop=/usr/bin/docker stop -t 10 aegis
Restart=always
RestartSec=1
NoNewPrivileges=true
[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable --now aegis
